{
  "name": "Desktop branch topology",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/linux-main",
        "refs/heads/windows-main"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "required_status_checks",
      "parameters": {
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {"context": "desktop-branch-topology"}
        ],
        "strict_required_status_checks_policy": false
      }
    }
  ]
}
