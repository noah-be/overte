# Normalize detected text to LF in the repository and in cross-platform
# working trees. Windows command scripts are the deliberate exception below.
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

# SVG is XML source: keep it normalized and reviewable as text.
*.svg text eol=lf diff

# Denote all files that are truly binary and should not be modified.
*.7z binary
*.arfont binary
*.bin binary
*.bmp binary
*.db binary
*.dds binary
*.eot binary
*.fbx binary
*.flac binary
*.gif binary
*.glb binary
*.gpg binary
*.gz binary
*.icns binary
*.ico binary
*.jar binary
*.jks binary
*.jpeg binary
*.jpg binary
*.ktx binary
*.mp3 binary
*.ogg binary
*.otf binary
*.pdf binary
*.png binary
*.psd binary
*.rsrc binary
*.ttf binary
*.unitypackage binary
*.wav binary
*.woff binary
*.woff2 binary
*.zip binary

# Conan recipe exports are preserved byte-for-byte from their locked RREVs.
# Some upstream patch payloads intentionally contain whitespace that Git would
# otherwise rewrite or reject during the repository diff check.
android/phone/fdroid/manifests/recipe-exports/** -text -eol -whitespace
