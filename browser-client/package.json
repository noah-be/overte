{
  "name": "overte-browser-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node tools/build-notices.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "gateway": "node gateway/server.mjs",
    "start": "node gateway/server.mjs",
    "test": "tsx --test src/*.test.ts tests/*.test.ts tests/*.test.mjs gateway/*.test.mjs",
    "test:browser": "playwright test",
    "lab:prepare": "python3 lab/manage.py prepare",
    "lab:start": "python3 lab/manage.py start --gateway",
    "lab:stop": "python3 lab/manage.py stop",
    "lab:status": "python3 lab/manage.py status",
    "test:integration": "node tests/integration/real-session.mjs",
    "predev": "node tools/prepare-default-avatar.mjs",
    "prebuild": "node tools/prepare-default-avatar.mjs"
  },
  "dependencies": {
    "draco3d": "1.3.4",
    "gifenc": "1.0.3",
    "three": "0.186.1",
    "three-mesh-bvh": "0.9.15",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.2",
    "puppeteer-core": "25.12.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
