// Local physical-device orchestration for the platform-neutral Overte runner.
// Test scenarios and target-specific automation deliberately stay outside this file.

String adapterManifest(String profile) {
    switch (profile) {
        case 'appium-android':
            return 'tests/device/adapters/appium/android.json'
        case 'appium-ios':
            return 'tests/device/adapters/appium/ios.json'
        case 'android-pico-adb':
            return 'tests/device/adapters/android/pico.json'
        case 'desktop-oculix-linux':
            return 'tests/device/adapters/desktop_oculix/linux.json'
        case 'desktop-oculix-macos':
            return 'tests/device/adapters/desktop_oculix/macos.json'
        case 'desktop-oculix-windows':
            return 'tests/device/adapters/desktop_oculix/windows.json'
        default:
            error("Unsupported target profile: ${profile}")
    }
}

String resolvedProfile() {
    if (params.TARGET_PROFILE?.trim() && params.TARGET_PROFILE.trim() != 'auto') {
        return params.TARGET_PROFILE.trim()
    }
    String profile = [
        'android-device-e2e': 'appium-android',
        'overte-device-phone-smoke': 'appium-android',
        'overte-e2e-android': 'appium-android',
        'ios-device-e2e': 'appium-ios',
        'ios-tablet-e2e-candidate': 'appium-ios',
        'overte-device-ipad-smoke': 'appium-ios',
        'overte-e2e-ios': 'appium-ios',
        'pico-device-e2e': 'android-pico-adb',
        'overte-device-pico-smoke': 'android-pico-adb',
        'overte-e2e-pico': 'android-pico-adb',
        'overte-e2e-linux': 'desktop-oculix-linux',
        'overte-e2e-macos': 'desktop-oculix-macos',
        'overte-e2e-windows': 'desktop-oculix-windows',
    ][env.JOB_BASE_NAME]
    if (!profile) {
        error('TARGET_PROFILE must be explicit for an unmapped Jenkins job')
    }
    return profile
}

String agentLabel(String profile) {
    if (profile == 'desktop-oculix-macos') {
        return 'overte-e2e-macos'
    }
    if (profile == 'desktop-oculix-windows') {
        return 'overte-e2e-windows'
    }
    return 'overte-device-interactive'
}

String deviceResource(String profile) {
    if (params.DEVICE_RESOURCE?.trim()) {
        return params.DEVICE_RESOURCE.trim()
    }
    return [
        'appium-android': 'android-device-01',
        'appium-ios': 'ios-device-01',
        'android-pico-adb': 'pico-device-01',
        'desktop-oculix-linux': 'linux-desktop-01',
        'desktop-oculix-macos': 'macos-desktop-01',
        'desktop-oculix-windows': 'windows-desktop-01',
    ][profile]
}

String fixturePort(String profile) {
    if (params.FIXTURE_PORT?.trim()) {
        return params.FIXTURE_PORT.trim()
    }
    return [
        'appium-android': '18080', 'appium-ios': '18081',
        'android-pico-adb': '18082', 'desktop-oculix-linux': '18083',
        'desktop-oculix-macos': '18084', 'desktop-oculix-windows': '18085',
    ][profile]
}

int profileOffset(String profile) {
    return ['appium-android', 'appium-ios', 'android-pico-adb',
            'desktop-oculix-linux', 'desktop-oculix-macos',
            'desktop-oculix-windows'].indexOf(profile)
}

def ciPython(String action, boolean returnStatus = false) {
    if (isUnix()) {
        return sh(script: "#!/bin/sh\nset +x\nexec python3 tests/device/jenkins/run_ci.py ${action}\n",
                  returnStatus: returnStatus)
    }
    return bat(script: "@echo off\r\npy -3 tests\\device\\jenkins\\run_ci.py ${action}\r\n",
               returnStatus: returnStatus)
}

def runDeviceSuite(String suite, int timeoutMinutes) {
    String profile = resolvedProfile()
    String manifest = adapterManifest(profile)
    String externalOutput = "${env.OVERTE_EXTERNAL_RESULT_ROOT}/${suite}"
    String stagedOutput = "${env.WORKSPACE}/device-ci-artifacts/${env.BUILD_NUMBER}/${suite}"
    List configuration = [
        "OVERTE_CI_WORKSPACE=${env.WORKSPACE}",
        "OVERTE_CI_ADAPTER_MANIFEST=${manifest}",
        'OVERTE_CI_CATALOG=tests/device/catalog.json',
        "OVERTE_CI_SUITE=${suite}",
        "OVERTE_CI_OUTPUT_DIR=${externalOutput}",
        "OVERTE_CI_STAGED_OUTPUT_DIR=${stagedOutput}",
        "OVERTE_CI_FIXTURE_PUBLIC_HOST=${params.FIXTURE_PUBLIC_HOST.trim()}",
        'OVERTE_CI_FIXTURE_BIND=0.0.0.0',
        "OVERTE_CI_FIXTURE_PORT=${fixturePort(profile)}",
        "OVERTE_CI_FIXTURE_MODE=${params.FIXTURE_MODE}",
        "OVERTE_CI_ALLOW_VIRTUAL=${params.ALLOW_VIRTUAL_TARGET ? '1' : '0'}",
        "OVERTE_E2E_CAPTURE_ARTIFACTS=${params.CAPTURE_FAILURE_ARTIFACTS ? '1' : '0'}",
        "OVERTE_IOS_ARTIFACT_SOURCE=${params.IOS_ARTIFACT_SOURCE}",
        "OVERTE_CI_DOMAIN_SERVER=${params.DOMAIN_SERVER_EXECUTABLE.trim()}",
        "OVERTE_CI_ASSIGNMENT_CLIENT=${params.ASSIGNMENT_CLIENT_EXECUTABLE.trim()}",
        "OVERTE_CI_DOMAIN_PORT=${40102 + profileOffset(profile) * 10}",
        "OVERTE_CI_DOMAIN_HTTP_PORT=${40100 + profileOffset(profile) * 10}",
        "OVERTE_CONAN_CACHE_ROOT=${env.OVERTE_BUILD_ISOLATION_ROOT}/conan",
        "OVERTE_ANDROID_BUILD_ROOT=${env.OVERTE_BUILD_ISOLATION_ROOT}/android",
        "OVERTE_DEVICE_STATE_ROOT=${env.OVERTE_BUILD_ISOLATION_ROOT}/state",
    ]
    if (profile == 'appium-ios') {
        configuration.add("OVERTE_APPIUM_TARGETS=${env.OVERTE_IOS_JOB_TARGET_CONFIG}")
        configuration.add("OVERTE_IOS_JOB_TARGET_CONFIG=${env.OVERTE_IOS_JOB_TARGET_CONFIG}")
        configuration.add("OVERTE_IOS_DDI_ROOT=${params.IOS_DDI_ROOT.trim()}")
    }
    if (suite == 'accessibility') {
        configuration.add('OVERTE_E2E_TABLET_OPEN_ACCESSIBILITY_ID=OverteTabletOpen')
        configuration.add('OVERTE_E2E_TABLET_CLOSE_ACCESSIBILITY_ID=OverteTabletClose')
    }
    if (suite == 'tablet-e2e') {
        configuration.add(
            'OVERTE_CI_TABLET_POLICY=tests/device/adapters/appium/ios-flat-touch-policy.json'
        )
    }

    withEnv(configuration) {
        try {
            lock(resource: deviceResource(profile), inversePrecedence: true) {
                withCredentials([string(credentialsId: params.TARGET_SELECTOR_CREDENTIAL_ID.trim(),
                                        variable: 'OVERTE_DEVICE_TARGET_SELECTOR')]) {
                    env.OVERTE_TARGET_NEEDS_CLEANUP = '1'
                    try {
                        timeout(time: timeoutMinutes, unit: 'MINUTES') {
                            if (profile == 'appium-ios') {
                                ciPython('ios-thermal-preflight')
                                ciPython('ios-ddi-preflight')
                            }
                            ciPython('run-suite')
                        }
                    } finally {
                        // Deliberately outside the expired per-suite timeout while
                        // still holding the resource lock.
                        int cleanupStatus = ciPython('cleanup-target', true)
                        if (cleanupStatus != 0) {
                            error("Target cleanup failed with exit code ${cleanupStatus}")
                        }
                        env.OVERTE_TARGET_NEEDS_CLEANUP = '0'
                    }
                }
            }
        } finally {
            // Results originate outside the checkout. Scan them for the private
            // selector before copying only publishable data into the workspace.
            int stagingStatus = 0
            withCredentials([string(credentialsId: params.TARGET_SELECTOR_CREDENTIAL_ID.trim(),
                                    variable: 'OVERTE_DEVICE_TARGET_SELECTOR')]) {
                stagingStatus = ciPython('stage-results', true)
            }
            junit(testResults: "device-ci-artifacts/${env.BUILD_NUMBER}/${suite}/junit.xml",
                  allowEmptyResults: false, keepLongStdio: true)
            archiveArtifacts(
                artifacts: "device-ci-artifacts/${env.BUILD_NUMBER}/${suite}/**",
                allowEmptyArchive: false,
                fingerprint: true
            )
            if (stagingStatus != 0) {
                error("Result staging reported an infrastructure failure")
            }
        }
    }
}

pipeline {
    agent { label agentLabel(resolvedProfile()) }

    options {
        timeout(time: 8, unit: 'HOURS')
        disableConcurrentBuilds(abortPrevious: false)
        buildDiscarder(logRotator(daysToKeepStr: '14', numToKeepStr: '20',
                                  artifactDaysToKeepStr: '7', artifactNumToKeepStr: '5'))
    }

    parameters {
        string(
            name: 'TARGET_PROFILE',
            defaultValue: 'auto',
            description: 'auto uses the canonical job mapping; otherwise an exact pinned profile.'
        )
        string(
            name: 'DEVICE_RESOURCE',
            defaultValue: '',
            description: 'Optional Lockable Resources override; never use a serial number here.'
        )
        string(
            name: 'TARGET_SELECTOR_CREDENTIAL_ID',
            defaultValue: 'overte-device-target-selector',
            description: 'ID of a Jenkins Secret Text credential containing the private selector.'
        )
        choice(
            name: 'IOS_ARTIFACT_SOURCE',
            choices: ['personal-team-preinstalled', 'local-personal-team', 'protected-github'],
            description: 'Observed preinstalled Personal Team apps (primary), exported signed IPAs, or optional protected signer.'
        )
        string(
            name: 'IOS_PREINSTALLED_ATTESTATION',
            defaultValue: '',
            description: 'Absolute private path to personal-team-preinstalled-attestation.json.'
        )
        string(
            name: 'IOS_DDI_ROOT',
            defaultValue: '',
            description: 'Private mode-0700 directory containing the exact pinned Personalized DDI triplet.'
        )
        string(
            name: 'IOS_LOCAL_UNSIGNED_KIT',
            defaultValue: '',
            description: 'Absolute private path to personal-team-e2e-kit.json for local import.'
        )
        string(
            name: 'IOS_LOCAL_ATTESTATION',
            defaultValue: '',
            description: 'Absolute private path to personal-team-signed-handoff.json.'
        )
        string(
            name: 'IOS_LOCAL_OVERTE_IPA',
            defaultValue: '',
            description: 'Absolute private path to the manually signed Overte Personal Team IPA.'
        )
        string(
            name: 'IOS_LOCAL_WDA_IPA',
            defaultValue: '',
            description: 'Absolute private path to the manually signed WDA Personal Team IPA.'
        )
        string(
            name: 'IOS_GITHUB_TOKEN_CREDENTIAL_ID',
            defaultValue: 'overte-ios-github-actions-token',
            description: 'Fine-grained GitHub token credential with Actions read/write for the protected producer.'
        )
        string(
            name: 'IOS_AGE_IDENTITY_CREDENTIAL_ID',
            defaultValue: 'overte-ios-age-identity',
            description: 'Secret File credential containing the Fedora lab age identity.'
        )
        string(
            name: 'IOS_PRODUCER_RUN_ID',
            defaultValue: '',
            description: 'Optional existing protected producer run; requires its exact attempt.'
        )
        string(
            name: 'IOS_PRODUCER_RUN_ATTEMPT',
            defaultValue: '',
            description: 'Exact positive attempt for IOS_PRODUCER_RUN_ID; blank only when dispatching.'
        )
        string(
            name: 'IOS_QT_HOST_CACHE_KEY',
            defaultValue: '',
            description: 'Audited Qt host-tools cache key required when dispatching the iOS producer.'
        )
        string(
            name: 'IOS_QT_IOS_CACHE_KEY',
            defaultValue: '',
            description: 'Audited Qt iOS cache key required when dispatching the iOS producer.'
        )
        string(
            name: 'IOS_QT_HOST_ARTIFACT_PREFIX',
            defaultValue: '',
            description: 'Durable audited Qt host-tools artifact prefix for the producer.'
        )
        string(
            name: 'IOS_QT_IOS_ARTIFACT_PREFIX',
            defaultValue: '',
            description: 'Durable audited Qt iOS artifact prefix for the producer.'
        )
        string(
            name: 'FIXTURE_PUBLIC_HOST',
            defaultValue: '',
            description: 'DNS name or LAN IPv4 address of this agent, reachable by the device.'
        )
        string(
            name: 'FIXTURE_PORT',
            defaultValue: '',
            description: 'Optional fixed LAN fixture port override; profiles have isolated defaults.'
        )
        choice(
            name: 'FIXTURE_MODE',
            choices: ['network'],
            description: 'Targets load the controlled fixture from the fixed test-lab origin.'
        )
        string(
            name: 'DOMAIN_SERVER_EXECUTABLE',
            defaultValue: '',
            description: 'Agent-local real domain-server binary, required only for domain smoke.'
        )
        string(
            name: 'ASSIGNMENT_CLIENT_EXECUTABLE',
            defaultValue: '',
            description: 'Agent-local real assignment-client binary, required only for domain smoke.'
        )
        booleanParam(
            name: 'ALLOW_VIRTUAL_TARGET',
            defaultValue: false,
            description: 'Allow an isolated hardware-GPU virtual display target.'
        )
        booleanParam(
            name: 'CAPTURE_FAILURE_ARTIFACTS',
            defaultValue: false,
            description: 'Capture potentially sensitive window/device screenshots on failures.'
        )
        booleanParam(
            name: 'RUN_CORE',
            defaultValue: true,
            description: 'Required iOS baseline: launch, scene, look, movement and tablet.'
        )
        booleanParam(
            name: 'RUN_ACCESSIBILITY',
            defaultValue: false,
            description: 'Run the audited native accessibility contract after core.'
        )
        booleanParam(
            name: 'RUN_TABLET_E2E',
            defaultValue: false,
            description: 'Run the deeper platform tablet product contract after portable smoke.'
        )
        booleanParam(
            name: 'RUN_DOMAIN_SMOKE',
            defaultValue: false,
            description: 'Run the real domain-server and assignment-client smoke fixture.'
        )
        booleanParam(
            name: 'RUN_SOAKS',
            defaultValue: false,
            description: 'Run long lifecycle and idle suites only after smoke/core pass.'
        )
    }

    stages {
        stage('Validate configuration') {
            steps {
                script {
                    String profile = resolvedProfile()
                    if (!(deviceResource(profile) ==~ /[A-Za-z0-9][A-Za-z0-9_.:-]*/)) {
                        error('DEVICE_RESOURCE contains unsupported characters')
                    }
                    if (!params.TARGET_SELECTOR_CREDENTIAL_ID.trim()) {
                        error('TARGET_SELECTOR_CREDENTIAL_ID is required')
                    }
                    if (profile == 'appium-ios') {
                        if (!params.IOS_DDI_ROOT.trim()) {
                            error('IOS_DDI_ROOT is required for physical XCTest on Fedora')
                        }
                        if (params.IOS_ARTIFACT_SOURCE == 'personal-team-preinstalled') {
                            if (!params.IOS_PREINSTALLED_ATTESTATION.trim()) {
                                error('IOS_PREINSTALLED_ATTESTATION is required for the preinstalled gate')
                            }
                        } else if (params.IOS_ARTIFACT_SOURCE == 'local-personal-team') {
                            if ([params.IOS_LOCAL_UNSIGNED_KIT,
                                 params.IOS_LOCAL_ATTESTATION,
                                 params.IOS_LOCAL_OVERTE_IPA,
                                 params.IOS_LOCAL_WDA_IPA].any { !it.trim() }) {
                                error('all four private Personal Team import paths are required')
                            }
                        } else {
                            if (!params.IOS_GITHUB_TOKEN_CREDENTIAL_ID.trim()) {
                                error('IOS_GITHUB_TOKEN_CREDENTIAL_ID is required for protected-github')
                            }
                            if (!params.IOS_AGE_IDENTITY_CREDENTIAL_ID.trim()) {
                                error('IOS_AGE_IDENTITY_CREDENTIAL_ID is required for protected-github')
                            }
                            if (params.IOS_PRODUCER_RUN_ID.trim().isEmpty() !=
                                    params.IOS_PRODUCER_RUN_ATTEMPT.trim().isEmpty()) {
                                error('IOS_PRODUCER_RUN_ID and IOS_PRODUCER_RUN_ATTEMPT must be supplied together')
                            }
                            if (params.IOS_PRODUCER_RUN_ID.trim() &&
                                    (!(params.IOS_PRODUCER_RUN_ID.trim() ==~ /[1-9][0-9]*/) ||
                                     !(params.IOS_PRODUCER_RUN_ATTEMPT.trim() ==~ /[1-9][0-9]*/))) {
                                error('producer run ID and attempt must be positive integers')
                            }
                            if (!params.IOS_PRODUCER_RUN_ID.trim() && [
                                    params.IOS_QT_HOST_CACHE_KEY,
                                    params.IOS_QT_IOS_CACHE_KEY,
                                    params.IOS_QT_HOST_ARTIFACT_PREFIX,
                                    params.IOS_QT_IOS_ARTIFACT_PREFIX,
                                ].any { !it.trim() }) {
                                error('all four audited Qt inputs are required to dispatch the iOS producer')
                            }
                        }
                    }
                    if (!params.RUN_CORE) {
                        error('RUN_CORE is mandatory for the cross-platform device-lab baseline')
                    }
                    if (!params.FIXTURE_PUBLIC_HOST.trim()) {
                        error('FIXTURE_PUBLIC_HOST is required for the core scene test')
                    }
                    if (!(fixturePort(profile) ==~ /[1-9][0-9]*/) ||
                            fixturePort(profile).toInteger() > 65535) {
                        error('FIXTURE_PORT must be a fixed TCP port from 1 through 65535')
                    }
                    adapterManifest(profile)
                    agentLabel(profile)
                    if (params.RUN_DOMAIN_SMOKE &&
                            (!params.DOMAIN_SERVER_EXECUTABLE.trim() ||
                             !params.ASSIGNMENT_CLIENT_EXECUTABLE.trim())) {
                        error('real domain-server and assignment-client binaries are required')
                    }
                    if (params.RUN_TABLET_E2E && profile != 'appium-ios') {
                        error('the deep tablet policy is currently accepted only for iOS')
                    }
                    if (!(env.BUILD_TAG ==~ /[A-Za-z0-9][A-Za-z0-9_.-]*/)) {
                        error('BUILD_TAG is unsafe for per-build cache isolation')
                    }
                    env.OVERTE_TARGET_NEEDS_CLEANUP = '0'
                    env.OVERTE_EXTERNAL_RESULT_ROOT =
                        "${pwd(tmp: true)}/overte-device-results/${env.BUILD_NUMBER}"
                    env.OVERTE_IOS_ARTIFACT_ROOT =
                        "${env.OVERTE_EXTERNAL_RESULT_ROOT}/private-ios-artifacts"
                    env.OVERTE_IOS_JOB_TARGET_CONFIG =
                        "${env.OVERTE_EXTERNAL_RESULT_ROOT}/private-ios-targets.json"
                    env.OVERTE_BUILD_ISOLATION_ROOT =
                        "${pwd(tmp: true)}/overte-e2e-isolation/${env.BUILD_TAG}"
                }
            }
        }

        stage('Device-free contracts') {
            steps {
                withEnv(["OVERTE_CI_WORKSPACE=${env.WORKSPACE}"]) {
                    script { ciPython('self-check') }
                }
            }
        }

        stage('Fedora iOS runtime') {
            when { expression { resolvedProfile() == 'appium-ios' } }
            steps {
                withEnv([
                    "OVERTE_CI_WORKSPACE=${env.WORKSPACE}",
                    "OVERTE_IOS_ARTIFACT_ROOT=${env.OVERTE_IOS_ARTIFACT_ROOT}",
                    "OVERTE_IOS_JOB_TARGET_CONFIG=${env.OVERTE_IOS_JOB_TARGET_CONFIG}",
                    "OVERTE_IOS_ARTIFACT_SOURCE=${params.IOS_ARTIFACT_SOURCE}",
                    "OVERTE_IOS_PREINSTALLED_ATTESTATION=${params.IOS_PREINSTALLED_ATTESTATION.trim()}",
                    "OVERTE_IOS_LOCAL_UNSIGNED_KIT=${params.IOS_LOCAL_UNSIGNED_KIT.trim()}",
                    "OVERTE_IOS_LOCAL_ATTESTATION=${params.IOS_LOCAL_ATTESTATION.trim()}",
                    "OVERTE_IOS_LOCAL_OVERTE_IPA=${params.IOS_LOCAL_OVERTE_IPA.trim()}",
                    "OVERTE_IOS_LOCAL_WDA_IPA=${params.IOS_LOCAL_WDA_IPA.trim()}",
                    "OVERTE_IOS_PRODUCER_RUN_ID=${params.IOS_PRODUCER_RUN_ID.trim()}",
                    "OVERTE_IOS_PRODUCER_RUN_ATTEMPT=${params.IOS_PRODUCER_RUN_ATTEMPT.trim()}",
                    "OVERTE_IOS_QT_HOST_CACHE_KEY=${params.IOS_QT_HOST_CACHE_KEY.trim()}",
                    "OVERTE_IOS_QT_IOS_CACHE_KEY=${params.IOS_QT_IOS_CACHE_KEY.trim()}",
                    "OVERTE_IOS_QT_HOST_ARTIFACT_PREFIX=${params.IOS_QT_HOST_ARTIFACT_PREFIX.trim()}",
                    "OVERTE_IOS_QT_IOS_ARTIFACT_PREFIX=${params.IOS_QT_IOS_ARTIFACT_PREFIX.trim()}",
                ]) {
                    withCredentials([string(
                        credentialsId: params.TARGET_SELECTOR_CREDENTIAL_ID.trim(),
                        variable: 'OVERTE_DEVICE_TARGET_SELECTOR'
                    )]) {
                        script {
                            ciPython('ios-runtime-preflight')
                            if (params.IOS_ARTIFACT_SOURCE == 'local-personal-team') {
                                ciPython('ios-artifact-sync')
                            } else if (params.IOS_ARTIFACT_SOURCE == 'protected-github') {
                                withCredentials([
                                    string(
                                        credentialsId: params.IOS_GITHUB_TOKEN_CREDENTIAL_ID.trim(),
                                        variable: 'OVERTE_GITHUB_TOKEN'
                                    ),
                                    file(
                                        credentialsId: params.IOS_AGE_IDENTITY_CREDENTIAL_ID.trim(),
                                        variable: 'OVERTE_IOS_AGE_IDENTITY_FILE'
                                    ),
                                ]) {
                                    ciPython('ios-artifact-sync')
                                }
                            }
                        }
                    }
                }
            }
        }

        stage('Preinstalled Personal Team gate') {
            when { expression {
                resolvedProfile() == 'appium-ios' &&
                    params.IOS_ARTIFACT_SOURCE == 'personal-team-preinstalled'
            } }
            steps {
                withEnv([
                    "OVERTE_CI_WORKSPACE=${env.WORKSPACE}",
                    "OVERTE_IOS_ARTIFACT_ROOT=${env.OVERTE_IOS_ARTIFACT_ROOT}",
                    "OVERTE_IOS_JOB_TARGET_CONFIG=${env.OVERTE_IOS_JOB_TARGET_CONFIG}",
                    'OVERTE_IOS_ARTIFACT_SOURCE=personal-team-preinstalled',
                    "OVERTE_IOS_PREINSTALLED_ATTESTATION=${params.IOS_PREINSTALLED_ATTESTATION.trim()}",
                ]) {
                    lock(resource: params.DEVICE_RESOURCE.trim(), inversePrecedence: true) {
                        withCredentials([string(
                            credentialsId: params.TARGET_SELECTOR_CREDENTIAL_ID.trim(),
                            variable: 'OVERTE_DEVICE_TARGET_SELECTOR'
                        )]) {
                            script { ciPython('ios-artifact-sync') }
                        }
                    }
                }
            }
        }

        stage('Cross-platform portable smoke') {
            steps {
                script { runDeviceSuite('portable-smoke', 45) }
            }
        }

        stage('Platform tablet contract') {
            when { expression {
                params.RUN_TABLET_E2E && resolvedProfile() == 'appium-ios'
            } }
            steps {
                script { runDeviceSuite('tablet-e2e', 20) }
            }
        }

        stage('Real domain fixture') {
            when { expression { params.RUN_DOMAIN_SMOKE } }
            steps {
                script { runDeviceSuite('domain-smoke', 30) }
            }
        }

        stage('Accessibility audit') {
            when { expression { params.RUN_ACCESSIBILITY } }
            steps {
                script { runDeviceSuite('accessibility', 15) }
            }
        }

        stage('Physical soaks') {
            when { expression { params.RUN_SOAKS } }
            steps {
                script {
                    runDeviceSuite('stability', 240)
                }
            }
        }
    }

    post {
        always {
            script {
                try {
                    // Normally each suite cleared this flag while still holding its
                    // lock. This final fallback covers an outer Pipeline timeout or
                    // an interrupted cleanup step.
                    if (env.OVERTE_TARGET_NEEDS_CLEANUP == '1') {
                        String profile = resolvedProfile()
                        String manifest = adapterManifest(profile)
                        List cleanupEnvironment = [
                            "OVERTE_CI_WORKSPACE=${env.WORKSPACE}",
                            "OVERTE_CI_ADAPTER_MANIFEST=${manifest}",
                        ]
                        if (profile == 'appium-ios') {
                            cleanupEnvironment.add(
                                "OVERTE_APPIUM_TARGETS=${env.OVERTE_IOS_JOB_TARGET_CONFIG}"
                            )
                        }
                        withEnv(cleanupEnvironment) {
                            lock(resource: deviceResource(profile), inversePrecedence: true) {
                                withCredentials([string(
                                    credentialsId: params.TARGET_SELECTOR_CREDENTIAL_ID.trim(),
                                    variable: 'OVERTE_DEVICE_TARGET_SELECTOR'
                                )]) {
                                    int cleanupStatus = ciPython('cleanup-target', true)
                                    if (cleanupStatus != 0) {
                                        echo "Final target cleanup failed with exit code ${cleanupStatus}"
                                    }
                                }
                            }
                        }
                    }
                } finally {
                    if (resolvedProfile() == 'appium-ios' &&
                            env.OVERTE_EXTERNAL_RESULT_ROOT?.trim()) {
                        withEnv([
                            "OVERTE_CI_WORKSPACE=${env.WORKSPACE}",
                            "OVERTE_EXTERNAL_RESULT_ROOT=${env.OVERTE_EXTERNAL_RESULT_ROOT}",
                            "OVERTE_IOS_ARTIFACT_ROOT=${env.OVERTE_IOS_ARTIFACT_ROOT}",
                            "OVERTE_IOS_JOB_TARGET_CONFIG=${env.OVERTE_IOS_JOB_TARGET_CONFIG}",
                        ]) {
                            int privateCleanupStatus = ciPython('cleanup-ios-private', true)
                            if (privateCleanupStatus != 0) {
                                error("Private iOS artifact cleanup failed with exit code ${privateCleanupStatus}")
                            }
                        }
                    }
                }
            }
        }
    }
}
