{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overte.org/schemas/device-probe-snapshot-v2.json",
  "title": "Overte E2E probe snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sampleEpochMs", "sampleSequence", "build", "application", "domain", "input", "scene", "avatar", "view", "tablet", "asset", "sound"],
  "properties": {
    "schemaVersion": {"const": 2},
    "sampleEpochMs": {"type": "integer", "minimum": 1},
    "sampleSequence": {"type": "integer", "minimum": 1},
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "version", "date"],
      "properties": {
        "platform": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "date": {"type": "string", "minLength": 1}
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["running", "foreground"],
      "properties": {
        "running": {"type": "boolean"},
        "foreground": {"type": "boolean"}
      }
    },
    "control": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "channel", "probe", "lastCommandId"],
          "properties": {
            "schemaVersion": {"const": 1},
            "channel": {"const": "android-debug-file-v1"},
            "probe": {"const": "overte_e2e_probe.js"},
            "lastCommandId": {"type": "string"}
          }
        }
      ]
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connected", "hostname", "id", "protocol", "serverless"],
      "properties": {
        "connected": {"type": "boolean"},
        "hostname": {"type": "string"},
        "id": {"type": "string"},
        "protocol": {"type": "string"},
        "serverless": {"type": "boolean"}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dominantHand", "advancedMovementControls"],
      "properties": {
        "dominantHand": {"enum": ["left", "right", "unknown"]},
        "advancedMovementControls": {"type": "boolean"}
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["muted"],
      "properties": {"muted": {"type": "boolean"}}
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audioWarnWhenMuted"],
      "properties": {"audioWarnWhenMuted": {"type": "boolean"}}
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frameCount", "lastFrameEpochMs"],
      "properties": {
        "frameCount": {"type": "integer", "minimum": 0},
        "lastFrameEpochMs": {"type": "integer", "minimum": 0}
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "ready", "entityCount", "fixtureMarkerCount", "fixtureMarkers", "domainMarkerCount", "domainMarkers", "floorTopY", "avatarAboveFloor", "spawnLocationObserved", "spawnValidated", "collisionWall"],
      "properties": {
        "url": {"type": "string"},
        "commandId": {"type": "string"},
        "ready": {"type": "boolean"},
        "entityCount": {"type": "integer", "minimum": 0},
        "fixtureMarkerCount": {"type": "integer", "minimum": 0},
        "fixtureMarkers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^OVERTE_E2E_[A-Z_]+$"}
        },
        "domainMarkerCount": {"type": "integer", "minimum": 0},
        "domainMarkers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^OVERTE_E2E_DOMAIN_[A-Z]+$"}
        },
        "floorTopY": {"type": ["number", "null"]},
        "avatarAboveFloor": {"type": "boolean"},
        "spawnLocationObserved": {"type": "boolean"},
        "spawnValidated": {"type": "boolean"},
        "collisionWall": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "center", "dimensions"],
              "properties": {
                "name": {"const": "OVERTE_E2E_COLLISION_WALL"},
                "center": {"$ref": "#/$defs/vector3"},
                "dimensions": {"$ref": "#/$defs/positiveVector3"}
              }
            }
          ]
        }
      }
    },
    "avatar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "feetPosition", "velocity", "bodyYawDegrees", "inAir", "flying", "flyingEnabled"],
      "properties": {
        "position": {"$ref": "#/$defs/vector3"},
        "feetPosition": {"$ref": "#/$defs/vector3"},
        "velocity": {"$ref": "#/$defs/vector3"},
        "bodyYawDegrees": {"type": "number"},
        "inAir": {"type": "boolean"},
        "flying": {"type": "boolean"},
        "flyingEnabled": {"type": "boolean"}
      },
      "allOf": [{
        "if": {"properties": {"flying": {"const": true}}},
        "then": {"properties": {"inAir": {"const": true}}}
      }]
    },
    "verticalEvents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jumpCount", "jumpCompletedCount", "lastJumpStartY", "lastJumpPeakY", "lastJumpLandingY", "flightCount", "lastFlightStartY", "lastFlightPeakY"],
      "properties": {
        "jumpCount": {"type": "integer", "minimum": 0},
        "jumpCompletedCount": {"type": "integer", "minimum": 0},
        "lastJumpStartY": {"type": ["number", "null"]},
        "lastJumpPeakY": {"type": ["number", "null"]},
        "lastJumpLandingY": {"type": ["number", "null"]},
        "flightCount": {"type": "integer", "minimum": 0},
        "lastFlightStartY": {"type": ["number", "null"]},
        "lastFlightPeakY": {"type": ["number", "null"]}
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orientation"],
      "properties": {
        "orientation": {"$ref": "#/$defs/vector3"},
        "orientationHistory": {
          "type": "array",
          "maxItems": 48,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sampleSequence", "orientation"],
            "properties": {
              "sampleSequence": {"type": "integer", "minimum": 1},
              "orientation": {"$ref": "#/$defs/vector3"}
            }
          }
        }
      }
    },
    "tablet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["open", "home", "toolbarMode"],
      "properties": {
        "open": {"type": "boolean"},
        "home": {"type": "boolean"},
        "toolbarMode": {"type": "boolean"}
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetAvailable", "pressCount", "lastEntityName", "lastPointerId"],
      "properties": {
        "targetAvailable": {"type": "boolean"},
        "pressCount": {"type": "integer", "minimum": 0},
        "lastEntityName": {"type": "string"},
        "lastPointerId": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "scriptedEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetAvailable", "loaded", "scriptUrl", "activationCount", "state", "color"],
      "properties": {
        "targetAvailable": {"type": "boolean"},
        "loaded": {"type": "boolean"},
        "scriptUrl": {"type": "string"},
        "activationCount": {"type": "integer", "minimum": 0},
        "state": {"enum": ["active", "idle", "unavailable"]},
        "color": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["red", "green", "blue"],
              "properties": {
                "red": {"type": "integer", "minimum": 0, "maximum": 255},
                "green": {"type": "integer", "minimum": 0, "maximum": 255},
                "blue": {"type": "integer", "minimum": 0, "maximum": 255}
              }
            }
          ]
        }
      }
    },
    "peer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "sessionId", "displayName", "position", "observationCount", "movementDistanceMeters"],
      "properties": {
        "present": {"type": "boolean"},
        "sessionId": {"type": "string"},
        "displayName": {"type": "string"},
        "position": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/vector3"}]},
        "observationCount": {"type": "integer", "minimum": 0},
        "movementDistanceMeters": {"type": "number", "minimum": 0}
      }
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axes", "buttons", "poses"],
      "properties": {
        "route": {
          "type": "object",
          "additionalProperties": false,
          "required": ["openxrAxes", "standardLy", "translateZAction", "rawTranslateZDriveKey", "translateZDriveKeyDisabled"],
          "properties": {
            "openxrAxes": {
              "oneOf": [
                {"type": "null"},
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["lx", "ly", "rx", "ry"],
                  "properties": {
                    "lx": {"type": "number"},
                    "ly": {"type": "number"},
                    "rx": {"type": "number"},
                    "ry": {"type": "number"}
                  }
                }
              ]
            },
            "standardLy": {"type": "number"},
            "translateYAction": {"type": "number"},
            "rawTranslateYDriveKey": {"type": "number"},
            "translateYDriveKeyDisabled": {"type": "boolean"},
            "translateZAction": {"type": "number"},
            "rawTranslateZDriveKey": {"type": "number"},
            "translateZDriveKeyDisabled": {"type": "boolean"}
          }
        },
        "axes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lx", "ly", "rx", "ry", "leftTrigger", "rightTrigger", "leftGrip", "rightGrip"],
          "properties": {
            "lx": {"type": "number"},
            "ly": {"type": "number"},
            "rx": {"type": "number"},
            "ry": {"type": "number"},
            "leftTrigger": {"type": "number"},
            "rightTrigger": {"type": "number"},
            "leftGrip": {"type": "number"},
            "rightGrip": {"type": "number"}
          }
        },
        "buttons": {
          "type": "object",
          "additionalProperties": false,
          "required": ["menu", "leftPrimary", "leftSecondary", "leftThumbstick", "leftTrigger", "rightPrimary", "rightSecondary", "rightThumbstick", "rightTrigger"],
          "properties": {
            "menu": {"type": "boolean"},
            "leftPrimary": {"type": "boolean"},
            "leftSecondary": {"type": "boolean"},
            "leftThumbstick": {"type": "boolean"},
            "leftTrigger": {"type": "boolean"},
            "rightPrimary": {"type": "boolean"},
            "rightSecondary": {"type": "boolean"},
            "rightThumbstick": {"type": "boolean"},
            "rightTrigger": {"type": "boolean"}
          }
        },
        "poses": {
          "type": "object",
          "additionalProperties": false,
          "required": ["left", "right"],
          "properties": {
            "left": {"$ref": "#/$defs/controllerPose"},
            "right": {"$ref": "#/$defs/controllerPose"}
          }
        }
      }
    },
    "asset": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["assetId", "resource", "entity"],
          "properties": {
            "assetId": {"type": "string", "minLength": 1},
            "resource": {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "state"],
              "properties": {
                "url": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://"},
                "state": {"enum": ["queued", "loading", "loaded", "finished", "failed"]}
              }
            },
            "entity": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "type", "imageURL", "naturalDimensions"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "name": {"type": "string", "minLength": 1},
                "type": {"const": "Image"},
                "imageURL": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://"},
                "naturalDimensions": {"$ref": "#/$defs/vector3"}
              }
            }
          }
        }
      ]
    },
    "sound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commandId", "url", "commandObserved", "resourceReady", "durationSeconds", "format", "injectorCreated", "started", "playing", "finished", "finishReason"],
      "properties": {
        "commandId": {"type": "string"},
        "url": {"type": "string"},
        "commandObserved": {"type": "boolean"},
        "resourceReady": {"type": "boolean"},
        "durationSeconds": {"type": "number", "minimum": 0},
        "format": {"enum": ["unknown", "wav"]},
        "injectorCreated": {"type": "boolean"},
        "started": {"type": "boolean"},
        "playing": {"type": "boolean"},
        "finished": {"type": "boolean"},
        "finishReason": {"enum": ["none", "natural", "stopped"]}
      }
    }
  },
  "$defs": {
    "vector3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "z": {"type": "number"}
      }
    },
    "quaternion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z", "w"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "z": {"type": "number"},
        "w": {"type": "number"}
      }
    },
    "controllerPose": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["valid", "translation", "rotation"],
          "properties": {
            "valid": {"const": false},
            "translation": {"type": "null"},
            "rotation": {"type": "null"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["valid", "translation", "rotation"],
          "properties": {
            "valid": {"const": true},
            "translation": {"$ref": "#/$defs/vector3"},
            "rotation": {"$ref": "#/$defs/quaternion"}
          }
        }
      ]
    },
    "positiveVector3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": {"type": "number", "exclusiveMinimum": 0},
        "y": {"type": "number", "exclusiveMinimum": 0},
        "z": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
