{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overte.org/schemas/device-execution-plan-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractVersion", "platform", "fixture", "fixtureProvider", "ready", "missingInputs", "suites"],
  "properties": {
    "schemaVersion": {"const": 1},
    "contractVersion": {"const": 1},
    "platform": {"type": "string", "minLength": 1},
    "fixture": {"enum": ["none", "scene", "domain"]},
    "fixtureProvider": {"enum": ["auto", "external", "none"]},
    "ready": {"type": "boolean"},
    "missingInputs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "suites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["suite", "state", "fixture", "session", "tier", "modules", "capabilities"],
        "properties": {
          "suite": {"type": "string", "minLength": 1},
          "state": {"enum": ["implemented", "accepted", "required"]},
          "fixture": {"enum": ["none", "scene", "domain"]},
          "session": {"enum": ["fresh", "reusable"]},
          "tier": {"enum": ["smoke", "extended", "soak"]},
          "modules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
