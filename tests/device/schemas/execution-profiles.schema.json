{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overte.org/schemas/device-execution-profiles-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractVersion", "suites"],
  "properties": {
    "schemaVersion": {"const": 1},
    "contractVersion": {"const": 1},
    "suites": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifacts", "fixture", "requiredEnvironment", "session", "tabletPolicy", "tier"],
        "properties": {
          "artifacts": {"type": "array", "uniqueItems": true, "items": {"enum": ["candidate", "source"]}},
          "fixture": {"enum": ["none", "scene", "domain"]},
          "requiredEnvironment": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^OVERTE_E2E_[A-Z0-9_]+$"}},
          "session": {"enum": ["fresh", "reusable"]},
          "tabletPolicy": {"type": "boolean"},
          "tier": {"enum": ["smoke", "extended", "soak"]}
        }
      }
    }
  }
}
