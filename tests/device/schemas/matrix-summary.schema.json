{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overte.org/schemas/device-acceptance-matrix-v1.json",
  "title": "Overte device E2E acceptance matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "required", "missing", "runs"],
  "properties": {
    "schemaVersion": {"const": 1},
    "status": {"enum": ["passed", "failed", "error"]},
    "required": {"$ref": "#/$defs/gates"},
    "missing": {"$ref": "#/$defs/gates"},
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["runId", "adapter", "platform", "physical", "suite", "status", "complete", "durationSeconds", "counts"],
        "properties": {
          "runId": {"type": "string", "pattern": "^run-[0-9]{3,}$"},
          "adapter": {"type": "string", "minLength": 1},
          "platform": {"type": "string", "minLength": 1},
          "physical": {"type": "boolean"},
          "suite": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "failed"]},
          "complete": {"type": "boolean"},
          "durationSeconds": {"type": "number", "minimum": 0},
          "counts": {
            "type": "object",
            "additionalProperties": false,
            "required": ["passed", "failed", "error", "skipped"],
            "properties": {
              "passed": {"type": "integer", "minimum": 0},
              "failed": {"type": "integer", "minimum": 0},
              "error": {"type": "integer", "minimum": 0},
              "skipped": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "gates": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*:[a-z][a-z0-9.-]*$"}
    }
  }
}
