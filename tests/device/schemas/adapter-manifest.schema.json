{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overte.org/schemas/device-adapter-manifest-v1.json",
  "title": "Overte physical-device adapter manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "command"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"},
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
