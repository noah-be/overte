{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overte.org/schemas/device-e2e-jenkins-plugin-artifacts-lock-v1.json",
  "title": "Overte Jenkins plugin artifact lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "jenkinsCore", "plugins"],
  "properties": {
    "schemaVersion": {"const": 1},
    "jenkinsCore": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "requiredCore", "url", "sha256"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "version": {"type": "string", "pattern": "^[^\\s:]+$"},
          "requiredCore": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"},
          "url": {"type": "string", "pattern": "^https://updates\\.jenkins\\.io/download/plugins/"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
