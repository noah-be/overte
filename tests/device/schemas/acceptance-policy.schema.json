{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overte.org/schemas/device-acceptance-policy-v1.json",
  "title": "Overte E2E platform acceptance policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractVersion", "platforms"],
  "properties": {
    "schemaVersion": {"const": 1},
    "contractVersion": {"const": 1},
    "platforms": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["defaultEvidence", "defaultState", "suites"],
        "properties": {
          "defaultEvidence": {"type": "string"},
          "defaultState": {"enum": ["implemented", "accepted", "required"]},
          "suites": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "evidence"],
              "properties": {
                "state": {"enum": ["implemented", "accepted", "required"]},
                "evidence": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
