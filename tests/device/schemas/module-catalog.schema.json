{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overte.org/schemas/device-module-catalog-v1.json",
  "title": "Overte physical-device module catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "modules"],
  "properties": {
    "schemaVersion": {"const": 1},
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "command", "suites", "requires", "timeoutSeconds"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"},
          "description": {"type": "string", "minLength": 1},
          "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "suites": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "requires": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "timeoutSeconds": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
