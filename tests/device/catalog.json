{
  "schemaVersion": 1,
  "modules": [
    {
      "id": "launch-smoke",
      "description": "Launch the application and verify a stable foreground process.",
      "command": ["modules/launch_smoke.py"],
      "suites": ["asset-smoke", "domain-recovery", "domain-smoke", "e2e-core", "e2e-recovery", "interaction-smoke", "smoke", "sound-smoke", "stability", "tablet-e2e", "vertical-locomotion"],
      "requires": ["app.foreground", "app.launch", "app.process"],
      "timeoutSeconds": 120
    },
    {
      "id": "scene",
      "description": "Load the controlled E2E scene and observe every required fixture marker.",
      "command": ["modules/scene.py"],
      "suites": ["e2e-core", "interaction-smoke"],
      "requires": ["probe.snapshot", "scene.load"],
      "timeoutSeconds": 120
    },
    {
      "id": "spawn-grounded",
      "description": "Verify the avatar spawns motionless, grounded, and above the fixture floor.",
      "command": ["modules/spawn_grounded.py"],
      "suites": ["e2e-core"],
      "requires": ["probe.snapshot", "scene.load"],
      "timeoutSeconds": 90
    },
    {
      "id": "domain-enter",
      "description": "Enter a controlled domain and observe its connection and assignment-owned scene.",
      "command": ["modules/domain_enter.py"],
      "suites": ["domain-recovery", "domain-smoke"],
      "requires": ["app.foreground", "app.process", "navigation.enter-domain", "probe.snapshot"],
      "timeoutSeconds": 180
    },
    {
      "id": "domain-roundtrip",
      "description": "Leave and re-enter the controlled domain while preserving one foreground process.",
      "command": ["modules/domain_roundtrip.py"],
      "suites": ["domain-recovery"],
      "requires": ["app.foreground", "app.process", "navigation.enter-domain", "probe.snapshot", "scene.load"],
      "timeoutSeconds": 240
    },
    {
      "id": "world-interaction",
      "description": "Perform one platform-native primary action on the controlled world target and observe the entity event.",
      "command": ["modules/world_interaction.py"],
      "suites": ["interaction-smoke"],
      "requires": ["app.foreground", "app.process", "input.primary", "probe.snapshot", "scene.load"],
      "timeoutSeconds": 120
    },
    {
      "id": "asset-load",
      "description": "Load a controlled local texture and verify HTTP, resource, entity, and process evidence.",
      "command": ["modules/asset_load.py"],
      "suites": ["asset-smoke"],
      "requires": ["app.foreground", "app.process", "asset.load", "probe.snapshot"],
      "timeoutSeconds": 120
    },
    {
      "id": "sound-playback",
      "description": "Load and decode the controlled WAV and observe a stable in-client injector lifecycle.",
      "command": ["modules/sound_playback.py"],
      "suites": ["sound-smoke"],
      "requires": ["app.process", "probe.snapshot", "sound.play"],
      "timeoutSeconds": 120
    },
    {
      "id": "look",
      "description": "Apply look input and observe signed left, right, up, and down camera rotations.",
      "command": ["modules/look.py"],
      "suites": ["e2e-core"],
      "requires": ["input.look", "probe.snapshot", "scene.load"],
      "timeoutSeconds": 90
    },
    {
      "id": "move",
      "description": "Apply forward, backward, left, and right input and verify body-relative displacement.",
      "command": ["modules/move.py"],
      "suites": ["e2e-core"],
      "requires": ["input.move", "probe.snapshot", "scene.load"],
      "timeoutSeconds": 90
    },
    {
      "id": "input-neutral",
      "description": "Verify bounded emulated controls leave no stuck movement or view input.",
      "command": ["modules/input_neutral.py"],
      "suites": ["e2e-core"],
      "requires": ["probe.snapshot", "scene.load"],
      "timeoutSeconds": 90
    },
    {
      "id": "collision",
      "description": "Move into the deterministic wall and verify avatar collision blocks passage.",
      "command": ["modules/collision.py"],
      "suites": ["e2e-core"],
      "requires": ["input.move", "probe.snapshot", "scene.load"],
      "timeoutSeconds": 120
    },
    {
      "id": "scene-reload",
      "description": "Reload the fixture and verify it restores a free grounded spawn before vertical locomotion.",
      "command": ["modules/scene_reload.py"],
      "suites": ["e2e-core", "e2e-recovery"],
      "requires": ["probe.snapshot", "scene.reload"],
      "timeoutSeconds": 120
    },
    {
      "id": "jump",
      "description": "Jump once, observe a non-flying ascent, and verify landing near the baseline.",
      "command": ["modules/jump.py"],
      "suites": ["e2e-core", "vertical-locomotion"],
      "requires": ["input.jump", "probe.snapshot", "scene.load"],
      "timeoutSeconds": 120
    },
    {
      "id": "fly",
      "description": "Fly for a bounded duration and observe active flight with vertical ascent.",
      "command": ["modules/fly.py"],
      "suites": ["e2e-core", "vertical-locomotion"],
      "requires": ["input.fly", "probe.snapshot", "scene.load"],
      "timeoutSeconds": 120
    },
    {
      "id": "tablet",
      "description": "Open and close the system tablet and observe both state transitions.",
      "command": ["modules/tablet.py"],
      "suites": ["e2e-core"],
      "requires": ["probe.snapshot", "scene.load", "tablet.close", "tablet.open"],
      "timeoutSeconds": 90
    },
    {
      "id": "tablet-input-isolation",
      "description": "Verify tablet-focused emulated input cannot move the avatar in the world.",
      "command": ["modules/tablet_input_isolation.py"],
      "suites": ["e2e-core"],
      "requires": ["input.move", "probe.snapshot", "scene.load", "tablet.close", "tablet.open"],
      "timeoutSeconds": 90
    },
    {
      "id": "app-restart",
      "description": "Stop and relaunch Overte with a new stable foreground process identity.",
      "command": ["modules/app_restart.py"],
      "suites": ["e2e-recovery"],
      "requires": ["app.foreground", "app.launch", "app.process", "app.stop"],
      "timeoutSeconds": 120
    },
    {
      "id": "tablet-e2e",
      "description": "Navigate the semantic tablet UI and enforce an external product policy without restarting the application.",
      "command": ["modules/tablet_e2e.py"],
      "suites": ["tablet-e2e"],
      "requires": ["app.process", "probe.snapshot", "tablet.activate", "tablet.close", "tablet.open", "tablet.snapshot"],
      "timeoutSeconds": 180
    },
    {
      "id": "accessibility",
      "description": "Audit stable tablet controls while reusing one controlled app session.",
      "command": ["modules/accessibility.py"],
      "suites": ["accessibility"],
      "requires": ["accessibility.snapshot", "app.launch", "app.process", "probe.snapshot", "scene.load", "tablet.close", "tablet.open"],
      "timeoutSeconds": 120
    },
    {
      "id": "lifecycle-soak",
      "description": "Repeat background and foreground transitions without a process restart.",
      "command": ["modules/lifecycle_soak.py"],
      "suites": ["lifecycle-stability"],
      "requires": ["app.foreground", "app.launch", "app.process", "lifecycle.background"],
      "timeoutSeconds": 3600
    },
    {
      "id": "idle-soak",
      "description": "Sample process, memory, battery, and thermal health while foregrounded.",
      "command": ["modules/idle_soak.py"],
      "suites": ["stability"],
      "requires": ["app.foreground", "app.launch", "app.process"],
      "timeoutSeconds": 7800
    }
  ]
}
