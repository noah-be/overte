{
  "schemaVersion": 1,
  "targets": [
    {
      "selector": "android-phone-01",
      "displayName": "Android Phone 01",
      "platform": "android",
      "physical": true,
      "enabled": true,
      "serverUrl": "http://127.0.0.1:4723",
      "appId": "org.overte.phone",
      "capabilities": {
        "platformName": "Android",
        "appium:automationName": "UiAutomator2",
        "appium:udid": "REPLACE_WITH_PRIVATE_UDID",
        "appium:systemPort": 8200,
        "appium:appPackage": "org.overte.phone",
        "appium:autoGrantPermissions": true,
        "appium:autoLaunch": false,
        "appium:noReset": true
      },
      "process": {
        "kind": "adb"
      },
      "scene": {
