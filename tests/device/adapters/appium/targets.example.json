      "controls": {
        "look": {"start": [0.75, 0.45], "end": [0.35, 0.45], "durationSeconds": 0.7},
        "move": {
          "forward": {"mode": "hold", "start": [0.086, 0.78], "end": [0.086, 0.6], "durationSeconds": 1.5}
        },
        "tablet": {
          "openPoint": [0.045, 0.25],
          "closePoint": [0.5, 0.965],
          "semanticUi": {
            "contractVersion": 1
          }
        }
      },
      "probe": {
        "kind": "android-run-as",
        "relativePath": "files/overte-e2e/overte-probe.json"
      },
      "clientControl": {
        "kind": "android-run-as-command",
        "relativePath": "files/overte-e2e/e2e-client-command.json"
      }
    },
    {
      "selector": "ipad-01",
      "displayName": "iPad 01",
      "platform": "ios",
      "physical": true,
      "enabled": false,
      "serverUrl": "http://127.0.0.1:4725",
      "appId": "REPLACE_WITH_SIGNED_APP_BUNDLE_ID",
      "capabilities": {
        "platformName": "iOS",
        "appium:automationName": "XCUITest",
        "appium:udid": "REPLACE_WITH_PRIVATE_UDID",
        "appium:wdaLocalPort": 8100,
        "appium:platformVersion": "REPLACE_WITH_IOS_VERSION_18_OR_NEWER",
        "appium:bundleId": "REPLACE_WITH_SIGNED_APP_BUNDLE_ID",
        "appium:app": "/private/overte-device-lab/ios/Overte-E2E-signed.ipa",
        "appium:usePreinstalledWDA": true,
        "appium:prebuiltWDAPath": "/private/overte-device-lab/ios/WebDriverAgentRunner-signed.ipa",
        "appium:updatedWDABundleId": "REPLACE_WITH_SIGNED_WDA_BUNDLE_ID_WITHOUT_XCTRUNNER_SUFFIX",
        "appium:autoLaunch": false,
        "appium:noReset": true
      },
      "artifactReceipt": "/private/overte-device-lab/ios/fedora-artifacts-receipt.json",
      "testBuild": {
        "contract": "overte-ios-e2e-v1",
