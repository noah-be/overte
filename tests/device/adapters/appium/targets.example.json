        "resultsDirectory": "overte-e2e",
        "launchArguments": ["--no-updater", "--no-login-suggestion"],
        "launchEnvironment": {
          "OVERTE_E2E_TEST_BUILD": "1"
        }
      },
      "scene": {
        "kind": "ios-test-build"
      },
      "controls": {
        "look": {"start": [0.75, 0.45], "end": [0.35, 0.45], "durationSeconds": 0.7},
        "move": {
          "forward": {"mode": "hold", "start": [0.2, 0.78], "end": [0.2, 0.55], "durationSeconds": 1.5}
        },
        "tablet": {
          "openAccessibilityId": "REPLACE_AFTER_ACCESSIBILITY_AUDIT",
