// Android Phone-only physical vertical-locomotion pipeline.
// The private Wi-Fi ADB wrapper is supplied by the Jenkins agent environment.

def ciPython(String action, boolean returnStatus = false) {
    return sh(
        script: "#!/bin/sh\nset +x\nexec python3 android/phone/device-tests/jenkins_ci.py ${action}\n",
        returnStatus: returnStatus
    )
}

def cleanupPhoneTarget(boolean returnStatus = false) {
    return ciPython('cleanup-target', returnStatus)
}

pipeline {
    agent { label 'overte-device-interactive' }

    options {
        timeout(time: 20, unit: 'MINUTES')
        disableConcurrentBuilds(abortPrevious: false)
        buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '15'))
    }

    parameters {
        string(
            name: 'DEVICE_RESOURCE',
            defaultValue: 'android-phone-wifi-01',
            description: 'Lockable Resources name; never use a device selector here.'
        )
        string(
            name: 'TARGET_SELECTOR_CREDENTIAL_ID',
            defaultValue: 'overte-android-phone-wifi-selector',
            description: 'Secret Text credential containing the wrapper target alias.'
        )
    }

    environment {
        OVERTE_ANDROID_E2E_DEBUG = '1'
        OVERTE_ANDROID_PHONE_E2E_INPUT = '1'
        OVERTE_E2E_SCENE_URL = 'overte-e2e://fixture/scene'
        OVERTE_E2E_POLL_SECONDS = '0.1'
        OVERTE_E2E_TIMEOUT_SECONDS = '45'
        OVERTE_ANDROID_E2E_PROBE_ATTEMPTS = '120'
        OVERTE_ANDROID_E2E_PROBE_POLL_SECONDS = '0.1'
        PHONE_BUILD_JOBS = '8'
        CMAKE_BUILD_PARALLEL_LEVEL = '8'
        SHADERGEN_JOBS = '8'
    }

    stages {
        stage('Validate Phone lab') {
            steps {
                script {
                    if (!(params.DEVICE_RESOURCE ==~ /[A-Za-z0-9][A-Za-z0-9_.:-]*/)) {
                        error('DEVICE_RESOURCE contains unsupported characters')
                    }
                    if (!params.TARGET_SELECTOR_CREDENTIAL_ID.trim()) {
                        error('TARGET_SELECTOR_CREDENTIAL_ID is required')
                    }
                    env.OVERTE_TARGET_NEEDS_CLEANUP = '0'
                    env.OVERTE_EXTERNAL_RESULT_ROOT =
                        "${pwd(tmp: true)}/overte-android-phone-results/${env.BUILD_NUMBER}"
                }
                sh '''#!/bin/sh
                    set -eu
                    set +x
                    test -n "${OVERTE_ANDROID_ADB:-}"
                    test -x "$OVERTE_ANDROID_ADB"
                    test -f android/phone/device-tests/adapter.json
                    test -f tests/device/catalog.json
                '''
            }
        }

        stage('Phone adapter contracts') {
            steps {
                sh '''#!/bin/sh
                    set -eu
                    systemd-run --user --scope --quiet \
                        -p MemoryMax=16G -p MemorySwapMax=0 \
                        env PHONE_BUILD_JOBS=8 CMAKE_BUILD_PARALLEL_LEVEL=8 \
                        SHADERGEN_JOBS=8 sh -c '\
                            python3 -m py_compile \
                                android/phone/device-tests/adapter.py \
                                android/phone/device-tests/jenkins_ci.py \
                                android/phone/device-tests/tests/test_adapter.py && \
                            python3 -m unittest \
                                android.phone.device-tests.tests.test_adapter'
                '''
            }
        }

        stage('Physical Jump and Fly') {
            steps {
                script {
                    String suite = 'vertical-locomotion'
                    String externalOutput = "${env.OVERTE_EXTERNAL_RESULT_ROOT}/${suite}"
                    String stagedOutput =
                        "${env.WORKSPACE}/device-ci-artifacts/${env.BUILD_NUMBER}/${suite}"
                    withEnv([
                        "OVERTE_CI_WORKSPACE=${env.WORKSPACE}",
                        'OVERTE_CI_ADAPTER_MANIFEST=android/phone/device-tests/adapter.json',
                        'OVERTE_CI_CATALOG=tests/device/catalog.json',
                        "OVERTE_CI_SUITE=${suite}",
                        "OVERTE_CI_OUTPUT_DIR=${externalOutput}",
                        "OVERTE_CI_STAGED_OUTPUT_DIR=${stagedOutput}",
                        'OVERTE_CI_FIXTURE_MODE=embedded',
                        'OVERTE_CI_ALLOW_VIRTUAL=0',
                        'OVERTE_E2E_CAPTURE_ARTIFACTS=0',
                    ]) {
                        try {
                            lock(resource: params.DEVICE_RESOURCE.trim(), inversePrecedence: true) {
                                withCredentials([string(
                                    credentialsId: params.TARGET_SELECTOR_CREDENTIAL_ID.trim(),
                                    variable: 'OVERTE_DEVICE_TARGET_SELECTOR'
                                )]) {
                                    env.OVERTE_TARGET_NEEDS_CLEANUP = '1'
                                    try {
                                        timeout(time: 5, unit: 'MINUTES') {
                                            ciPython('run-suite')
                                        }
                                    } finally {
                                        int cleanupStatus = cleanupPhoneTarget(true)
                                        if (cleanupStatus != 0) {
                                            error("Target cleanup failed with exit code ${cleanupStatus}")
                                        }
                                        env.OVERTE_TARGET_NEEDS_CLEANUP = '0'
                                    }
                                }
                            }
                        } finally {
                            int stagingStatus = 0
                            withCredentials([string(
                                credentialsId: params.TARGET_SELECTOR_CREDENTIAL_ID.trim(),
                                variable: 'OVERTE_DEVICE_TARGET_SELECTOR'
                            )]) {
                                stagingStatus = ciPython('stage-results', true)
                            }
                            junit(
                                testResults: "device-ci-artifacts/${env.BUILD_NUMBER}/${suite}/junit.xml",
                                allowEmptyResults: false,
                                keepLongStdio: true
                            )
                            archiveArtifacts(
                                artifacts: "device-ci-artifacts/${env.BUILD_NUMBER}/${suite}/**",
                                allowEmptyArchive: false,
                                fingerprint: true
                            )
                            if (stagingStatus != 0) {
                                error('Result staging reported an infrastructure failure')
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                if (env.OVERTE_TARGET_NEEDS_CLEANUP == '1'
                        && (params.DEVICE_RESOURCE ==~ /[A-Za-z0-9][A-Za-z0-9_.:-]*/)
                        && params.TARGET_SELECTOR_CREDENTIAL_ID.trim()) {
                    lock(resource: params.DEVICE_RESOURCE.trim(), inversePrecedence: true) {
                        withCredentials([string(
                            credentialsId: params.TARGET_SELECTOR_CREDENTIAL_ID.trim(),
                            variable: 'OVERTE_DEVICE_TARGET_SELECTOR'
                        )]) {
                            cleanupPhoneTarget(true)
                        }
                    }
                }
            }
        }
    }
}
