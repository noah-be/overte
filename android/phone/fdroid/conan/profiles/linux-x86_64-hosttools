include(../../profiles/linux-x86_64-hosttools)

[options]
qt/*:shared=True
qt/*:gui=True
qt/*:widgets=False
qt/*:opengl=no
qt/*:with_vulkan=False
qt/*:openssl=False
qt/*:qtdeclarative=True
qt/*:qttools=True
qt/*:qtscxml=True
qt/*:qtsvg=False
qt/*:qtgraphicaleffects=False
qt/*:qtimageformats=False
qt/*:qtlocation=False
qt/*:qtmultimedia=False
qt/*:qtquickcontrols=False
qt/*:qtquickcontrols2=False
qt/*:qtxmlpatterns=False
qt/*:qtwebchannel=False
qt/*:qtwebsockets=False
qt/*:qtwebview=False
qt/*:qtwebengine=False
qt/*:with_dbus=False
qt/*:with_glib=False
qt/*:with_gssapi=False
qt/*:with_icu=False
qt/*:with_pcre2=True
qt/*:with_doubleconversion=True
# QtGui's Linux platform plugins require fontdatabase_support-private. The
# pinned Qt sources only build that module on Linux with FreeType enabled.
qt/*:with_freetype=True
qt/*:with_fontconfig=False
qt/*:with_harfbuzz=False
qt/*:with_libjpeg=False
qt/*:with_libpng=False
qt/*:with_mysql=False
qt/*:with_odbc=False
qt/*:with_openal=False
qt/*:with_pq=False
qt/*:with_sqlite3=True
qt/*:with_zstd=False
qt/*:with_x11=False

[conf]
tools.system.package_manager:mode=report
tools.system.package_manager:sudo=False
