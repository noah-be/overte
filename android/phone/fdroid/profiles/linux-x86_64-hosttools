[settings]
os=Linux
arch=x86_64
compiler=gcc
compiler.version=15
compiler.libcxx=libstdc++11
compiler.cppstd=gnu20
build_type=Release

[options]
qt/*:shared=True
qt/*:gui=True
qt/*:widgets=False
qt/*:opengl=no
qt/*:with_vulkan=False
qt/*:openssl=False
qt/*:qtdeclarative=True
qt/*:qttools=True
qt/*:qtscxml=True
qt/*:qtsvg=False
qt/*:qtgraphicaleffects=False
qt/*:qtimageformats=False
qt/*:qtlocation=False
qt/*:qtmultimedia=False
qt/*:qtquickcontrols=False
qt/*:qtquickcontrols2=False
qt/*:qtxmlpatterns=False
qt/*:qtwebchannel=False
qt/*:qtwebsockets=False
qt/*:qtwebview=False
qt/*:qtwebengine=False
qt/*:with_dbus=False
qt/*:with_glib=False
qt/*:with_gssapi=False
qt/*:with_icu=False
qt/*:with_pcre2=True
qt/*:with_doubleconversion=True
qt/*:with_freetype=False
qt/*:with_fontconfig=False
qt/*:with_harfbuzz=False
qt/*:with_libjpeg=False
qt/*:with_libpng=False
qt/*:with_mysql=False
qt/*:with_odbc=False
qt/*:with_openal=False
qt/*:with_pq=False
qt/*:with_sqlite3=True
qt/*:with_zstd=False
qt/*:with_x11=False

[conf]
tools.build:jobs=4
tools.system.package_manager:mode=report
tools.system.package_manager:sudo=False
