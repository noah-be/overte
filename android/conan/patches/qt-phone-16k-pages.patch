diff --git a/qtbase/mkspecs/android-clang/qmake.conf b/qtbase/mkspecs/android-clang/qmake.conf
index f65b6089939..58e785dd64e 100644
--- a/qtbase/mkspecs/android-clang/qmake.conf
+++ b/qtbase/mkspecs/android-clang/qmake.conf
@@ -55,6 +55,16 @@ QMAKE_LFLAGS_NOUNDEF    = -Wl,--no-undefined
 QMAKE_LFLAGS_RPATH      = -Wl,-rpath=
 QMAKE_LFLAGS_RPATHLINK  = -Wl,-rpath-link=
 
+# Android 15+ devices may use a 16 KiB page size. Keep this Qt 5 build
+# independent of bionic's compile-time PAGE_SIZE and align every ELF LOAD.
+# The compatibility flags are also needed by QtLocation's bundled Boost 1.65
+# when compiling against the NDK 27 libc++ headers.
+DEFINES                += __BIONIC_NO_PAGE_SIZE_MACRO _LIBCPP_ENABLE_CXX17_REMOVED_UNARY_BINARY_FUNCTION
+QMAKE_CXXFLAGS         += -Wno-enum-constexpr-conversion -Wno-c++11-narrowing-const-reference
+QMAKE_LFLAGS_APP       += -Wl,-z,max-page-size=16384 -Wl,-z,common-page-size=16384
+QMAKE_LFLAGS_SHLIB     += -Wl,-z,max-page-size=16384 -Wl,-z,common-page-size=16384
+QMAKE_LFLAGS_PLUGIN    += -Wl,-z,max-page-size=16384 -Wl,-z,common-page-size=16384
+
 equals(QMAKE_HOST.os, Windows) {
     QMAKE_LINK_OBJECT_MAX = 10
     QMAKE_LINK_OBJECT_SCRIPT = object_script
