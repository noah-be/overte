#!/usr/bin/env bash
set -euo pipefail

legacy_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
android_root="$(cd -- "$legacy_dir/../.." && pwd)"
python_command="${OVERTE_LEGACY_PYTHON_COMMAND:-python3}"
cache_root="${OVERTE_LEGACY_GRADLE_CACHE_DIR:-$android_root/build/tools/legacy-gradle-6.5}"
gradle_command="${OVERTE_LEGACY_GRADLE_COMMAND:-$cache_root/gradle-6.5/bin/gradle}"
export JAVA_HOME="${OVERTE_LEGACY_JAVA_HOME:-/usr/lib/jvm/java-8-temurin-jdk}"

"$python_command" \
    "$android_root/common/tests/legacy-gradle/run_dependency_report.py" \
    toolchain --offline

cd -- "$legacy_dir"
exec "$gradle_command" --no-daemon "$@"
