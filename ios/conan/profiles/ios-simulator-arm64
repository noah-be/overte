[settings]
os=iOS
os.version=17.0
os.sdk=iphonesimulator
arch=armv8
compiler=apple-clang
compiler.version=17
compiler.libcxx=libc++
compiler.cppstd=20
build_type=Release

[conf]
tools.cmake.cmaketoolchain:generator=Xcode
{% set sdk_path = os.getenv("OVERTE_IOS_SIMULATOR_SDK_PATH", "") %}
{% if sdk_path %}
tools.apple:sdk_path={{ sdk_path }}
{% endif %}

[options]
*:shared=False
*:fPIC=True
