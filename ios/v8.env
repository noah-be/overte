# V8 12.4 is the runtime embedded by Node.js 22. The exact tag is pinned so
# the archive consumed by the application has a reproducible source identity.
OVERTE_IOS_V8_VERSION=12.4.254.21
OVERTE_IOS_V8_REVISION=8ab91836885699b9ef686c3a30df4778501ef7d1

# depot_tools has no stable releases. Pin a reviewed revision rather than
# allowing its moving main branch to change an otherwise identical cache key.
OVERTE_IOS_DEPOT_TOOLS_REVISION=680218310e32a8411f243c0946c4af6264d4fc87

OVERTE_IOS_V8_DEPLOYMENT_TARGET=15.0
